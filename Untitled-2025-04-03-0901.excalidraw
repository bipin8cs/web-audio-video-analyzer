    {
      "id": "L77HMs3zXLkkbqNOdOcsp",
      "type": "text",
      "x": 53.6953125,
      "y": 1360.21484375,
      "width": 972.4391479492188,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 1813668958,
      "version": 339,
      "versionNonce": 1398181022,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1743653677176,
      "link": null,
      "locked": false,
      "text": "Audio Source\n-media source node -<audio> <video>\n-media stream element source node-->webRTC\n-Audio Buffer source node-raw data(stored in in-memory) --Array Buffer(binary data you can store)\n\n\n2)Audio Effects\n   - gain nodes(change in volume)\n-analyzer node\n-filter node \n-delay node \n\n3)Audio destination\n-Hardwares(speakers)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Audio Source\n-media source node -<audio> <video>\n-media stream element source node-->webRTC\n-Audio Buffer source node-raw data(stored in in-memory) --Array Buffer(binary data you can store)\n\n\n2)Audio Effects\n   - gain nodes(change in volume)\n-analyzer node\n-filter node \n-delay node \n\n3)Audio destination\n-Hardwares(speakers)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
